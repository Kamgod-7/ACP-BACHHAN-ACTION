/* ========================================================= */
/* ACP-BACHHAN ACTION — PREMIUM VISUAL ENHANCEMENT LAYER */
/* Core gameplay untouched: same click-to-kill, movement, damage, score and timing. */
/* ========================================================= */

:root {
  --hud-bg: rgba(5, 8, 12, .72);
  --hud-line: rgba(255,255,255,.14);
  --neon-green: #00e676;
  --neon-orange: #ff9f1a;
  --neon-red: #ff3b30;
  --hud-blur: 14px;
}

#game-container::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 60;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0,0,0,.34), transparent 18%, transparent 78%, rgba(0,0,0,.48)),
    radial-gradient(ellipse at center, transparent 48%, rgba(0,0,0,.30) 100%);
  mix-blend-mode: multiply;
}

#game-container::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 61;
  pointer-events: none;
  opacity: .14;
  background: repeating-linear-gradient(0deg, rgba(255,255,255,.08) 0 1px, transparent 1px 4px);
}

#game-world {
  isolation: isolate;
  will-change: transform;
}

#character, .enemy {
  will-change: left, transform, filter;
}

#character {
  filter: drop-shadow(0 24px 16px rgba(0,0,0,.78)) drop-shadow(0 0 12px rgba(255,153,51,.10));
}

.enemy {
  filter: drop-shadow(0 22px 14px rgba(0,0,0,.82));
}

/* Stronger, cleaner player health display */
.health-container {
  width: 72%;
  height: 24px;
  top: -36px;
  padding: 3px;
  background: rgba(3,5,8,.86);
  border: 1px solid rgba(255,255,255,.32);
  box-shadow: 0 5px 18px rgba(0,0,0,.6), inset 0 0 10px rgba(0,0,0,.8);
}

.health-fill {
  border-radius: 7px;
  background: linear-gradient(90deg, #ff2020 0%, #ff6b35 45%, #ffd23f 100%);
  box-shadow: 0 0 14px rgba(255,54,34,.62);
}

.health-text {
  font-size: 11px;
  letter-spacing: 1px;
  text-shadow: 0 1px 3px #000;
}

/* Rebuilt combat HUD */
#score-hud {
  display: flex;
  align-items: stretch;
  gap: 0;
  padding: 0;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(7,11,15,.88), rgba(12,16,20,.62));
  border: 1px solid var(--hud-line);
  border-radius: 14px;
  backdrop-filter: blur(var(--hud-blur)) saturate(1.35);
  -webkit-backdrop-filter: blur(var(--hud-blur)) saturate(1.35);
  box-shadow: 0 10px 30px rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.08);
}

.hud-stat {
  min-width: 104px;
  padding: 9px 15px 10px;
  border-right: 1px solid rgba(255,255,255,.09);
}

.hud-stat:last-child { border-right: 0; }

#score-hud .score-label {
  display: block;
  margin: 0 0 3px;
  font-family: 'Chakra Petch', 'Orbitron', sans-serif;
  font-size: .55rem;
  letter-spacing: 2.5px;
  color: rgba(255,255,255,.48);
}

#score-hud .score-value {
  font-family: 'Chakra Petch', 'Orbitron', sans-serif;
  font-size: 1rem;
  line-height: 1;
  letter-spacing: 1.5px;
  text-shadow: 0 0 12px rgba(255,255,255,.22);
}

.combo-stat .score-value {
  color: var(--neon-orange);
  text-shadow: 0 0 12px rgba(255,159,26,.38);
}

.threat-value {
  color: var(--neon-green) !important;
  font-size: .78rem !important;
}

.top-actions {
  position: fixed;
  top: 14px;
  right: 14px;
  z-index: 1003;
  display: flex;
  gap: 8px;
}

.top-actions #about-us-btn {
  position: static;
}

.hud-action {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.16);
  background: rgba(5,8,12,.72);
  color: #fff;
  font: 900 1rem 'Chakra Petch', 'Orbitron', sans-serif;
  cursor: pointer;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 8px 22px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.08);
  transition: transform .18s ease, border-color .18s ease, background .18s ease;
}

.hud-action:hover {
  transform: translateY(-2px);
  border-color: var(--neon-green);
  background: rgba(0,230,118,.14);
}

.hud-action:active { transform: translateY(1px) scale(.96); }

#game-status {
  position: fixed;
  left: 50%;
  top: 17px;
  z-index: 1002;
  transform: translateX(-50%);
  padding: 6px 12px;
  border: 1px solid rgba(0,230,118,.24);
  border-radius: 999px;
  color: rgba(255,255,255,.68);
  background: rgba(5,8,12,.42);
  font: 700 .55rem 'Chakra Petch', 'Orbitron', sans-serif;
  letter-spacing: 3px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  pointer-events: none;
}

#game-status::before {
  content: '';
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 7px;
  border-radius: 50%;
  background: var(--neon-green);
  box-shadow: 0 0 9px var(--neon-green);
  animation: statusPulse 1.3s ease-in-out infinite;
}

@keyframes statusPulse { 50% { opacity: .35; transform: scale(.75); } }

/* Reticle gives the click target a polished arcade feel */
#combat-reticle {
  position: fixed;
  left: -100px;
  top: -100px;
  width: 34px;
  height: 34px;
  z-index: 1500;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%,-50%) scale(.72);
  transition: opacity .16s ease, transform .16s ease;
}

#combat-reticle.reticle-active {
  opacity: .9;
  transform: translate(-50%,-50%) scale(1);
}

#combat-reticle::before, #combat-reticle::after, #combat-reticle span::before, #combat-reticle span::after {
  content: '';
  position: absolute;
  background: rgba(255,255,255,.9);
  box-shadow: 0 0 7px rgba(255,153,51,.9);
}

#combat-reticle::before { width: 2px; height: 10px; left: 16px; top: 0; }
#combat-reticle::after { width: 2px; height: 10px; left: 16px; bottom: 0; }
#combat-reticle span::before { width: 10px; height: 2px; left: 0; top: 16px; }
#combat-reticle span::after { width: 10px; height: 2px; right: 0; top: 16px; }

#combat-reticle span {
  position: absolute;
  inset: 11px;
  border: 1px solid rgba(255,153,51,.9);
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(255,153,51,.45);
}

/* Projectile polish */
.fireball {
  background: radial-gradient(circle, #fff 4%, #fff7b0 16%, #ffb000 36%, #ff4b00 63%, transparent 74%);
  box-shadow: 0 0 10px #fff, 0 0 24px #ffb000, 0 0 50px #ff3b00;
  filter: saturate(1.35);
}

.fireball::after {
  content: '';
  position: absolute;
  width: 170%;
  height: 36%;
  left: -125%;
  top: 32%;
  border-radius: 50%;
  background: linear-gradient(90deg, transparent, rgba(255,90,0,.72), rgba(255,240,170,.85));
  filter: blur(4px);
  opacity: .75;
}

.muzzle-flash {
  position: absolute;
  width: calc(100px * var(--game-scale));
  height: calc(58px * var(--game-scale));
  transform: translate(-50%,-50%);
  z-index: 31;
  pointer-events: none;
  background: radial-gradient(ellipse, #fff 0 8%, #ffd54f 20%, #ff6d00 46%, transparent 72%);
  filter: blur(.4px) drop-shadow(0 0 14px #ff7a00);
  animation: muzzleFlash .14s ease-out forwards;
}

@keyframes muzzleFlash {
  from { opacity: 1; transform: translate(-50%,-50%) scale(.65) rotate(-6deg); }
  to { opacity: 0; transform: translate(-50%,-50%) scale(1.55) rotate(4deg); }
}

/* Hit feedback */
.hit-marker {
  position: absolute;
  width: calc(38px * var(--game-scale));
  height: calc(38px * var(--game-scale));
  transform: translate(-50%,-50%);
  z-index: 80;
  pointer-events: none;
  animation: hitMarker .26s ease-out forwards;
}

.hit-marker::before, .hit-marker::after {
  content: '';
  position: absolute;
  inset: 5px;
  border-top: 3px solid #fff;
  border-left: 3px solid #fff;
  transform: rotate(45deg);
  filter: drop-shadow(0 0 5px #ff9f1a);
}

.hit-marker::after {
  transform: rotate(225deg);
}

@keyframes hitMarker {
  from { opacity: 1; transform: translate(-50%,-50%) scale(.55); }
  65% { opacity: 1; transform: translate(-50%,-50%) scale(1.15); }
  to { opacity: 0; transform: translate(-50%,-50%) scale(1.4); }
}

.score-pop {
  position: absolute;
  z-index: 81;
  pointer-events: none;
  color: #fff;
  font: 900 calc(20px * var(--game-scale)) 'Chakra Petch', 'Orbitron', sans-serif;
  letter-spacing: 1px;
  text-shadow: 0 2px 4px #000, 0 0 12px rgba(255,159,26,.65);
  animation: scorePop .82s cubic-bezier(.2,.8,.2,1) forwards;
}

@keyframes scorePop {
  0% { opacity: 0; transform: translateY(12px) scale(.7); }
  18% { opacity: 1; transform: translateY(0) scale(1.12); }
  100% { opacity: 0; transform: translateY(calc(-65px * var(--game-scale))) scale(1); }
}

#screen-flash {
  position: fixed;
  inset: 0;
  z-index: 1490;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(circle at center, rgba(255,50,40,.34), transparent 58%);
}

#screen-flash.damage-flash {
  animation: damageFlash .22s ease-out;
}

@keyframes damageFlash {
  0% { opacity: 0; }
  25% { opacity: 1; }
  100% { opacity: 0; }
}

.click-ripple {
  position: fixed;
  width: 18px;
  height: 18px;
  z-index: 1495;
  border: 2px solid rgba(255,255,255,.8);
  border-radius: 50%;
  transform: translate(-50%,-50%) scale(.2);
  pointer-events: none;
  animation: clickRipple .42s ease-out forwards;
}

@keyframes clickRipple {
  to { opacity: 0; transform: translate(-50%,-50%) scale(3.6); border-color: rgba(255,159,26,0); }
}

/* More premium menus without changing their contents */
.glass-panel {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(15,19,23,.86), rgba(4,6,8,.78));
  border: 1px solid rgba(255,255,255,.13);
  box-shadow: 0 24px 70px rgba(0,0,0,.68), inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(18px) saturate(1.25);
  -webkit-backdrop-filter: blur(18px) saturate(1.25);
}

.glass-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(120deg, rgba(255,255,255,.06), transparent 32%, transparent 68%, rgba(0,200,83,.035));
}

.title {
  font-family: 'Chakra Petch', 'Orbitron', sans-serif;
  text-shadow: 0 4px 20px rgba(0,0,0,.9), 0 0 20px rgba(0,230,118,.08);
}

.premium-btn {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.16);
  background: linear-gradient(100deg, #00b85a, #00d26a 48%, #ff9b2f);
  box-shadow: 0 10px 28px rgba(0,200,83,.22), inset 0 1px 0 rgba(255,255,255,.22);
}

.premium-btn::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -60%;
  width: 35%;
  height: 200%;
  transform: rotate(20deg);
  background: rgba(255,255,255,.24);
  transition: left .5s ease;
}

.premium-btn:hover::after { left: 125%; }

.brand-footer-global {
  font-family: 'Chakra Petch', 'Orbitron', sans-serif;
  opacity: .78;
  letter-spacing: 2.5px;
}

@media (max-width: 760px) {
  #score-hud { transform: scale(.82); transform-origin: top left; }
  .hud-stat { min-width: 86px; padding: 8px 11px; }
  #game-status { top: 11px; font-size: .46rem; }
  .top-actions { top: 9px; right: 9px; transform: scale(.88); transform-origin: top right; }
  .brand-footer-global { font-size: .62rem; bottom: 8px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
}
