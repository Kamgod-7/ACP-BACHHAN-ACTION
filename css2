@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

/* ========================================================= */
/* SETTINGS: CHARACTER SIZE, POSITION & STOP CONTROLS */
/* ========================================================= */
:root {
--game-scale: 1;

--char-width: 500px;
--char-height: 500px;
--char-left: 0%;
--char-bottom: 1%;

--enemy-width: 400px;
--enemy-height: 400px;
--enemy-bottom: 4%;
--enemy-spawn-offset: 100px;

--sword-stop-x: 10%; 
--sword-vanish-gap: 160px; 

--gun-shoot-start-x: 90%; 

--bullet-spawn-x: 100%;
--bullet-spawn-y: 25%;
--fireball-size: 70px;

--enemy-bullet-offset-y: -61px; 
--enemy-bullet-offset-x: 30px; 

/* SANKIBYTES BRAND COLORS */
--bg-main: #121212;
--bg-sec: #0D0D0D;
--acc-pri: #00C853;
--acc-sec: #FF9933;
--text-main: #FFFFFF;
--glass-bg: rgba(13, 13, 13, 0.7);
--glass-border: rgba(255, 255, 255, 0.08);
}

/* ========================================================= */

* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

body, html {
position: fixed;
width: 100%;
height: 100%;
overflow: hidden;
background-color: var(--bg-main);
user-select: none;
-webkit-user-select: none;
touch-action: none;
font-family: 'Orbitron', sans-serif;
}

#game-container {
position: absolute;
width: 100vw;
height: 100vh;
width: 100dvw;
height: 100dvh;
top: 0;
left: 0;
background-image: url('https://pub-742a4db0fefe4d9b9bf82cf1432444c3.r2.dev/Gangsta%20Bachlun/Gnagsta%20Bachlun%20Bg.webp');
background-size: 100% 100%;
background-position: center;
background-repeat: no-repeat;
overflow: hidden;
}

#game-world {
position: absolute;
width: 100%;
height: 100%;
top: 0;
left: 0;
}

@keyframes shakeAnimation {
  0% { transform: translate(1px, 1px) rotate(0deg); }
  25% { transform: translate(-3px, -2px) rotate(-1deg); }
  50% { transform: translate(3px, 2px) rotate(1deg); }
  75% { transform: translate(-1px, -1px) rotate(0deg); }
  100% { transform: translate(0px, 0px) rotate(0deg); }
}
.shake-effect {
  animation: shakeAnimation 0.2s cubic-bezier(.36,.07,.19,.97) both;
}

@keyframes massiveShakeAnimation {
  0%, 100% { transform: translate(0, 0); }
  10%, 30%, 50%, 70%, 90% { transform: translate(-20px, -15px) rotate(-4deg); }
  20%, 40%, 60%, 80% { transform: translate(20px, 15px) rotate(4deg); }
}
.massive-shake-effect {
  animation: massiveShakeAnimation 0.5s cubic-bezier(.36,.07,.19,.97) both;
}

/* EXPLOSION & EFFECTS */
.blast-fire {
    position: absolute; width: calc(120px * var(--game-scale)); height: calc(120px * var(--game-scale));
    background: radial-gradient(circle, #fff 10%, #ffcc00 30%, #ff3300 70%, transparent 100%);
    border-radius: 50%; transform: translate(-50%, -50%) scale(0);
    animation: explodeFire 0.4s ease-out forwards; z-index: 40; pointer-events: none;
}
.blast-smoke {
    position: absolute; width: calc(150px * var(--game-scale)); height: calc(150px * var(--game-scale));
    background: radial-gradient(circle, #444 20%, #111 60%, transparent 100%);
    border-radius: 50%; transform: translate(-50%, -50%) scale(0);
    animation: explodeSmoke 0.8s ease-out forwards; z-index: 39; pointer-events: none; opacity: 0.9;
}
@keyframes explodeFire {
    0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
}
@keyframes explodeSmoke {
    0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0.9; }
    100% { transform: translate(-50%, calc(-150px * var(--game-scale))) scale(2.5); opacity: 0; }
}

.white-flash {
    position: absolute; width: calc(300px * var(--game-scale)); height: calc(300px * var(--game-scale)); background: #fff; border-radius: 50%;
    transform: translate(-50%, -50%); animation: flashFade 0.3s ease-out forwards; z-index: 50; pointer-events: none;
}
.shockwave {
    position: absolute; width: calc(50px * var(--game-scale)); height: calc(50px * var(--game-scale)); border: 8px solid rgba(255, 255, 255, 0.9); border-radius: 50%;
    transform: translate(-50%, -50%); animation: shockExpand 0.5s ease-out forwards; z-index: 45; pointer-events: none;
}
.massive-fire {
    width: calc(300px * var(--game-scale)); height: calc(300px * var(--game-scale)); animation: explodeFireMassive 0.6s ease-out forwards;
}
.massive-smoke {
    position: absolute; width: calc(250px * var(--game-scale)); height: calc(250px * var(--game-scale));
    background: radial-gradient(circle, rgba(30,30,30,0.95) 20%, rgba(10,10,10,0.8) 60%, transparent 100%);
    border-radius: 50%; z-index: 48; pointer-events: none;
    animation: explodeSmokeMassiveNew 2.5s ease-out forwards;
}
.scorch-mark {
    position: absolute; width: calc(250px * var(--game-scale)); height: calc(60px * var(--game-scale));
    background: radial-gradient(ellipse, rgba(0,0,0,0.9) 20%, rgba(0,0,0,0) 70%);
    border-radius: 50%; transform: translate(-50%, -50%); z-index: 4; pointer-events: none;
}
@keyframes flashFade {
    0% { transform: translate(-50%, -50%) scale(0.1); opacity: 1; }
    50% { transform: translate(-50%, -50%) scale(3); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(4); opacity: 0; }
}
@keyframes shockExpand {
    0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; border-width: 25px; }
    100% { transform: translate(-50%, -50%) scale(15); opacity: 0; border-width: 1px; }
}
@keyframes explodeFireMassive {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(4); opacity: 0; }
}
@keyframes explodeSmokeMassiveNew {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    100% { transform: translate(-50%, calc(-400px * var(--game-scale))) scale(6); opacity: 0; }
}

.spark { position: absolute; background: #fff; box-shadow: 0 0 10px 4px #ff7300; border-radius: 50%; z-index: 49; pointer-events: none; }
.chunk { position: absolute; background: #111; border-radius: 30% 50% 20% 40%; box-shadow: inset -3px -3px 8px #000; z-index: 46; pointer-events: none; }
.flesh-chunk { position: absolute; background: #600000; border-radius: 40% 20% 50% 30%; box-shadow: inset -2px -2px 6px #200000; z-index: 46; pointer-events: none; }
.small-debris { position: absolute; background: #222; border-radius: 50%; z-index: 46; pointer-events: none; }

.sprite {
position: absolute;
background-size: 400% 400%;
background-position: 0% 0%;
background-repeat: no-repeat;
filter: drop-shadow(0px 20px 10px rgba(0, 0, 0, 0.7));
transition: opacity 0.1s;
}

#character {
width: calc(var(--char-width) * var(--game-scale));
height: calc(var(--char-height) * var(--game-scale));
left: var(--char-left);
bottom: var(--char-bottom);
background-image: url('https://pub-742a4db0fefe4d9b9bf82cf1432444c3.r2.dev/Gangsta%20Bachlun/Gansgta%20Bachlun.webp');
z-index: 10; 
}

.health-container {
position: absolute;
top: -30px;
left: 50%;
transform: translateX(-50%);
width: 60%;
height: 20px;
background: rgba(0,0,0,0.8);
border: 2px solid #fff;
border-radius: 10px;
overflow: hidden;
z-index: 20;
}
.health-fill {
width: 100%;
height: 100%;
background: linear-gradient(90deg, #ff0000, #ff4500);
transition: width 0.2s ease-out;
}
.health-text {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
color: #fff;
font-size: 13px;
font-weight: bold;
line-height: 1;
white-space: nowrap;
font-family: 'Orbitron', sans-serif;
}

.enemy {
width: calc(var(--enemy-width) * var(--game-scale));
height: calc(var(--enemy-height) * var(--game-scale));
bottom: var(--enemy-bottom);
transform: scaleX(-1);
z-index: 5;
cursor: crosshair;
}

.blood-particle {
position: absolute;
background: radial-gradient(circle, #ff0000 20%, #8b0000 80%);
border-radius: 50%;
pointer-events: none;
z-index: 25;
transition: transform 0.3s ease-out, opacity 0.3s ease-out;
}

.damage-text {
position: absolute;
color: #ff3333;
font-weight: 900;
font-family: 'Orbitron', sans-serif;
-webkit-text-stroke: 1px black;
text-shadow: 2px 2px 0 #000;
pointer-events: none;
z-index: 30;
animation: floatUp 0.8s ease-out forwards;
}
@keyframes floatUp {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(calc(-70px * var(--game-scale))) scale(1.3); opacity: 0; }
}

.fireball {
position: absolute;
width: calc(var(--fireball-size) * var(--game-scale));
height: calc(var(--fireball-size) * var(--game-scale));
background: radial-gradient(circle, #ffffff 10%, var(--acc-sec) 30%, #ff3300 70%, transparent 100%);
border-radius: 50%;
box-shadow: 0 0 20px #ff4500, 0 0 40px #ff0000, 0 0 60px #ff7300;
z-index: 15;
pointer-events: none;
}

.enemy-bullet {
position: absolute;
width: calc(25px * var(--game-scale));
height: calc(8px * var(--game-scale));
background: var(--acc-sec);
border-radius: 10px;
box-shadow: 0 0 10px #ff0000;
z-index: 15;
pointer-events: none;
}

@media screen and (orientation: portrait) {
#game-container, #ui-layer, #intro-screen, #about-screen {
width: 100vh !important;
height: 100vw !important;
width: 100dvh !important;
height: 100dvw !important;
transform: rotate(90deg);
transform-origin: top left;
top: 0;
left: 100vw !important;
}
}

/* ========================================================= */
/* 📱 KAMAL GOD PREMIUM UI REDESIGN */
/* ========================================================= */
#ui-layer {
position: absolute;
top: 0; left: 0;
width: 100vw;
height: 100vh;
width: 100dvw;
height: 100dvh;
z-index: 100;
display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
background-color: rgba(13, 13, 13, 0.85); /* Semi-transparent dark bg */
backdrop-filter: blur(8px);
-webkit-backdrop-filter: blur(8px);
color: var(--text-main);
transition: opacity 0.5s ease;
}
.hidden { display: none !important; }

/* Glassmorphism Panel */
.glass-panel {
background: var(--glass-bg);
border: 1px solid var(--glass-border);
border-radius: 20px;
padding: 50px 40px;
box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
text-align: center;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
min-width: 340px;
max-width: 90%;
}

/* Typography */
.brand-text {
font-size: 1.1rem;
color: var(--acc-pri);
letter-spacing: 4px;
margin-bottom: 5px;
font-weight: 700;
text-shadow: 0 0 10px rgba(0, 200, 83, 0.5);
}

.title { 
font-size: 2.5rem; 
font-weight: 900; 
margin-bottom: 30px; 
text-transform: uppercase; 
color: var(--text-main); 
letter-spacing: 2px;
text-shadow: 0 5px 15px rgba(0, 0, 0, 0.8);
}

.loss-title { 
font-size: 2.8rem; 
color: #ff3333; 
text-shadow: 0 0 20px rgba(255, 51, 51, 0.6); 
}

/* Loading Bar Setup */
.progress-container {
width: 100%;
height: 8px;
background: rgba(255, 255, 255, 0.1);
border-radius: 10px;
margin: 20px 0;
position: relative;
overflow: hidden;
box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
}
.progress-fill {
height: 100%;
width: 0%;
background: linear-gradient(90deg, var(--acc-pri), var(--acc-sec));
border-radius: 10px;
transition: width 0.3s ease;
box-shadow: 0 0 15px var(--acc-pri);
}
.loading-details {
font-size: 0.9rem;
color: rgba(255, 255, 255, 0.7);
letter-spacing: 1px;
margin-top: 10px;
}

/* Premium Buttons */
.premium-btn {
padding: 16px 45px; 
font-size: 1.2rem; 
font-weight: 700;
background: linear-gradient(45deg, var(--acc-pri), var(--acc-sec)); 
color: #fff;
border: none; 
border-radius: 30px;
cursor: pointer; 
text-transform: uppercase;
box-shadow: 0 8px 20px rgba(0, 200, 83, 0.3);
transition: all 0.3s ease;
pointer-events: auto;
font-family: 'Orbitron', sans-serif;
letter-spacing: 2px;
width: 100%;
max-width: 260px;
margin-bottom: 15px;
}
.premium-btn:hover { 
transform: translateY(-3px) scale(1.02); 
box-shadow: 0 12px 25px rgba(255, 153, 51, 0.5);
}
.premium-btn:active { 
transform: translateY(1px) scale(0.98); 
}

/* Secondary Button for Pause Menu */
.btn-secondary {
background: rgba(255, 255, 255, 0.05);
border: 1px solid rgba(255, 255, 255, 0.2);
box-shadow: none;
color: var(--text-main);
}
.btn-secondary:hover {
background: rgba(255, 255, 255, 0.1);
box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
}

/* ========================================================= */
/* 🎬 INTRO / SPLASH SCREEN */
/* ========================================================= */
#intro-screen {
position: absolute;
top: 0; left: 0;
width: 100vw; height: 100vh;
width: 100dvw; height: 100dvh;
z-index: 1000;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
cursor: pointer;
background: radial-gradient(circle at 50% 42%, #1c1c1c 0%, #0a0a0a 55%, #000000 100%);
transition: opacity .75s ease, transform .75s cubic-bezier(.55,0,.1,1), filter .75s ease;
}
#intro-screen.intro-exit {
opacity: 0;
transform: scale(1.18);
filter: blur(16px);
pointer-events: none;
}

.intro-vignette {
position: absolute;
inset: 0;
box-shadow: inset 0 0 22vw rgba(0,0,0,0.9);
pointer-events: none;
}

.intro-embers {
position: absolute;
inset: 0;
overflow: hidden;
pointer-events: none;
}
.intro-ember {
position: absolute;
bottom: -10px;
width: 4px; height: 4px;
border-radius: 50%;
background: radial-gradient(circle, #fff, var(--acc-sec) 55%, transparent 100%);
box-shadow: 0 0 6px var(--acc-sec);
opacity: 0;
animation-name: introEmberRise;
animation-timing-function: linear;
animation-iteration-count: infinite;
}
@keyframes introEmberRise {
0% { transform: translate(0, 0); opacity: 0; }
8% { opacity: .9; }
90% { opacity: .7; }
100% { transform: translate(var(--drift, 20px), -115vh); opacity: 0; }
}

.intro-scan {
position: absolute;
top: -10%; bottom: -10%;
width: 30%;
background: linear-gradient(100deg, transparent, rgba(255,255,255,.10) 45%, rgba(255,255,255,.4) 50%, rgba(255,255,255,.10) 55%, transparent);
transform: translateX(-160%) skewX(-14deg);
animation: introScanSweep 1.3s ease-in-out .2s 1 both;
pointer-events: none;
}
@keyframes introScanSweep {
to { transform: translateX(260%) skewX(-14deg); }
}

.intro-content {
position: relative;
z-index: 2;
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
padding: 0 24px;
}

.intro-sub {
display: block;
font-size: clamp(0.7rem, 2.8vw, 1rem);
font-weight: 700;
letter-spacing: 7px;
color: var(--acc-sec);
text-shadow: 0 0 10px rgba(255,153,51,.55);
opacity: 0;
transform: translateY(-18px);
animation: introSubIn .6s cubic-bezier(.2,.8,.2,1) forwards;
animation-delay: .25s;
}
.intro-sub-2 {
margin-top: 4px;
color: rgba(255,255,255,.85);
letter-spacing: 9px;
text-shadow: none;
transform: translateY(18px);
animation-delay: .5s;
}
@keyframes introSubIn {
to { opacity: 1; transform: translateY(0); }
}

.intro-title {
display: flex;
flex-wrap: wrap;
justify-content: center;
margin-top: 16px;
font-size: clamp(2.1rem, 10.5vw, 4.4rem);
font-weight: 900;
letter-spacing: 1px;
color: #fff;
line-height: 1;
animation: introGlowPulse 2.4s ease-in-out infinite;
animation-delay: 1.75s;
}
.intro-title span {
display: inline-block;
opacity: 0;
animation: introLetterPop .7s cubic-bezier(.2,.8,.2,1) both;
animation-delay: calc(0.9s + (var(--i) * 70ms));
}
.intro-title .intro-space { width: 0.35em; }
@keyframes introLetterPop {
0% { opacity: 0; transform: translateY(46px) scale(.4) rotateX(65deg); filter: blur(5px); }
55% { opacity: 1; transform: translateY(-8px) scale(1.12) rotateX(0deg); filter: blur(0); }
78% { transform: translateY(3px) scale(.97); }
100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes introGlowPulse {
0%, 100% { text-shadow: 0 0 14px rgba(0,200,83,.9), 0 0 30px rgba(0,200,83,.45), 0 4px 14px rgba(0,0,0,.85); }
50% { text-shadow: 0 0 20px rgba(255,153,51,.9), 0 0 40px rgba(255,153,51,.5), 0 4px 14px rgba(0,0,0,.85); }
}

.intro-underline {
width: 0%;
max-width: 320px;
height: 3px;
margin: 16px auto 0;
background: linear-gradient(90deg, transparent, var(--acc-pri), var(--acc-sec), transparent);
box-shadow: 0 0 12px var(--acc-pri);
animation: introUnderline .8s cubic-bezier(.2,.8,.2,1) forwards;
animation-delay: 1.8s;
}
@keyframes introUnderline {
to { width: 72%; }
}

.intro-tap-hint {
position: absolute;
bottom: 6%;
left: 50%;
transform: translateX(-50%);
font-size: 0.7rem;
letter-spacing: 3px;
color: rgba(255,255,255,.4);
opacity: 0;
animation: introFadeIn .8s ease forwards 2.6s, introPulseOpacity 1.7s ease-in-out infinite 3.4s;
}
@keyframes introFadeIn { to { opacity: 1; } }
@keyframes introPulseOpacity { 0%, 100% { opacity: .25; } 50% { opacity: .7; } }

/* Footer Global - always visible, independent of ui-layer show/hide */
.brand-footer-global {
position: fixed;
left: 50%;
bottom: 15px;
transform: translateX(-50%);
font-size: 0.8rem; 
letter-spacing: 2px; 
color: rgba(255, 255, 255, 0.5);
text-transform: uppercase;
text-shadow: 0 1px 3px rgba(0,0,0,0.8);
z-index: 999;
pointer-events: none;
white-space: nowrap;
}

/* ========================================================= */
/* 🏆 SCORE HUD + ABOUT US TAB + CONTACT OVERLAY (KAMAL GOD UPDATE) */
/* ========================================================= */
#score-hud {
position: fixed;
top: 14px;
left: 14px;
z-index: 1002;
padding: 8px 20px;
font-family: 'Orbitron', sans-serif;
letter-spacing: 2px;
background: var(--glass-bg);
border: 1px solid var(--glass-border);
border-radius: 20px;
backdrop-filter: blur(6px);
-webkit-backdrop-filter: blur(6px);
box-shadow: 0 4px 14px rgba(0,0,0,0.5);
pointer-events: none;
}
#score-hud .score-label {
font-size: 0.65rem;
color: var(--acc-sec);
margin-right: 8px;
}
#score-hud .score-value {
font-size: 1rem;
font-weight: 900;
color: var(--text-main);
}

#about-us-btn {
position: fixed;
top: 14px;
right: 14px;
z-index: 1002;
padding: 8px 18px;
font-family: 'Orbitron', sans-serif;
font-size: 0.75rem;
font-weight: 700;
letter-spacing: 2px;
color: var(--text-main);
background: var(--glass-bg);
border: 1px solid var(--glass-border);
border-radius: 20px;
cursor: pointer;
text-transform: uppercase;
backdrop-filter: blur(6px);
-webkit-backdrop-filter: blur(6px);
box-shadow: 0 4px 14px rgba(0,0,0,0.5);
transition: all 0.25s ease;
pointer-events: auto;
}
#about-us-btn:hover {
background: rgba(0, 200, 83, 0.18);
border-color: var(--acc-pri);
transform: translateY(-2px);
}

/* About / Contact overlay - reuses the splash-intro's atmosphere classes */
#about-screen {
position: fixed;
top: 0; left: 0;
width: 100vw; height: 100vh;
width: 100dvw; height: 100dvh;
z-index: 2000;
display: none;
align-items: center;
justify-content: center;
overflow: hidden;
cursor: pointer;
background: radial-gradient(circle at 50% 42%, #1c1c1c 0%, #0a0a0a 55%, #000000 100%);
transition: opacity .6s ease, transform .6s cubic-bezier(.55,0,.1,1), filter .6s ease;
}
#about-screen.about-visible {
display: flex;
}
#about-screen.about-exit {
opacity: 0;
transform: scale(1.15);
filter: blur(14px);
pointer-events: none;
}

.about-title-fade {
opacity: 0;
transform: translateY(30px) scale(0.85);
animation: aboutTitleIn 0.9s cubic-bezier(.2,.8,.2,1) forwards 0.3s,
           introGlowPulse 2.4s ease-in-out infinite 1.2s;
}
@keyframes aboutTitleIn {
to { opacity: 1; transform: translateY(0) scale(1); }
}

#about-contact {
position: relative;
z-index: 2;
cursor: default;
}

.contact-email {
display: inline-block;
margin: 18px 0 22px;
font-size: 1.1rem;
font-weight: 700;
letter-spacing: 1px;
color: var(--acc-pri);
text-decoration: none;
word-break: break-all;
text-shadow: 0 0 10px rgba(0, 200, 83, 0.4);
}
.contact-email:hover { color: var(--acc-sec); }

.contact-quote {
font-size: 0.95rem;
font-style: italic;
line-height: 1.6;
color: rgba(255,255,255,0.85);
max-width: 320px;
margin: 0 0 6px;
}
.contact-quote-author {
display: block;
font-size: 0.8rem;
font-style: normal;
letter-spacing: 1px;
color: var(--acc-sec);
margin-bottom: 26px;
}


/* ========================================================= */
/* SUPPLIED FONT ASSETS */
/* ========================================================= */
/* thai */
@font-face {
  font-family: 'Chakra Petch';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/chakrapetch/v13/cIflMapbsEk7TDLdtEz1BwkebIl1U5_F7AY.woff2) format('woff2');
  unicode-range: U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC;
}
/* vietnamese */
